		workflow
		{
		form
		{
			auto_set_posted_by as "Auto-set Posted By Field"
			{
				type =  form
				form = announcement

				record event = on add
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Get the logged-in user's email address
										loggedInUserEmail = zoho.loginuserid;
										// Set the posted_by field with the logged-in user's email
										input.posted_by = loggedInUserEmail;
						)
					}
				}

			}
			validate_valid_till_date as "Validate Valid Till Date"
			{
				type =  form
				form = announcement

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if valid_till date is in the past
										if(input.valid_till.isValidObject())
										{
											currentDate = now.getDate();
											validTillDate = input.valid_till.getDate();
											if(validTillDate < currentDate)
											{
												alert "Invalid entries found: Valid till date cannot be in the past. Please enter a future date.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_on_new_announcement as "Notify on New Announcement"
			{
				type =  form
				form = announcement

				record event = on add
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Get the current announcement details
										announcementTitle = input.title;
										announcementMessage = input.message;
										announcementCategory = input.category;
										// Get the logged-in user's email
										senderEmail = zoho.loginuserid;
										// Construct email subject and message
										subject = "New Announcement: " + announcementTitle;
										input.message = "<p>Dear User,</p>" + "<p>A new announcement has been posted.</p>" + "<p><strong>Title:</strong> " + announcementTitle + "</p>" + "<p><strong>Category:</strong> " + announcementCategory + "</p>" + "<p><strong>Message:</strong></p>" + "<p>" + announcementMessage + "</p>" + "<p>Thank you,</p>" + "<p>Campus Announcement Management System</p>";
										// Send email notification to the logged-in user
										sendmail
										[
											from :zoho.loginuserid
											to :zoho.loginuserid
											subject :subject
											message :input.message
											content type :HTML
										]
										// Display success message
										success message "Email notification sent successfully.";
						)
					}
				}

			}
			TESTING as "TESTING"
			{
				type =  form
				form = announcement

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "karthi.d.2024.cse@rajalakshmi.edu.in"
							subject : "Record Added"
							message : "<div>${zoho.loginuserid} has added a record in form Announcement<br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			daily_expired_notice_alert as "Daily Expired Notice Alert"
			{
				type =  schedule
				form = announcement
					status = inactive
				start = valid_till at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch announcements expiring today
										expiringAnnouncements = announcement[valid_till == today];
										// Check if there are any expiring announcements
										if(expiringAnnouncements.count() > 0)
										{
											// Build email message
											messageBody = "<p>The following announcements are expiring today:</p><ul>";
											for each  announcement in expiringAnnouncements
											{
												input.title = announcement.title;
												input.category = announcement.category;
												messageBody = messageBody.concat("<li>").concat(input.title).concat(" (Category: ").concat(input.category).concat(")</li>");
											}
											messageBody = messageBody.concat("</ul>");
											// Send email notification
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.loginuserid
												subject :"Daily Alert: Announcements Expiring Today"
												message :messageBody
												content type :HTML
											]
										}
					)
					}
				}
			}
		}




	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Department Coordinator"
			{
				name = "Department Coordinator"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Create and publish specific notices for their academic department \n"
				ModulePermissions
				{
					announcement
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							announcement_by_category={"View","Edit"}
							announcement_Report={"View","Edit"}
						}
					}
				}
			}
			"System Integrator"
			{
				name = "System Integrator"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Configure REST API endpoints for external system connectivity \n"
				ModulePermissions
				{
					announcement
					{
						enabled= Viewall,Export 
						allFieldsVisible= true 
