 application "Campus Announcement Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form announcement
		{
			displayname = "Announcement"
			success message = "Announcement Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			title
			(
    			type = text
				displayname = "Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			message
			(
    			type = textarea
				displayname = "Message"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = picklist
				displayname = "Category"
				values = {"Placement","Event","Academic"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			valid_till
			(
    			type = date
				displayname = "Valid Till"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			posted_by
			(
    			type = text
				displayname = "Posted By"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Draft Created","Pending Review","Approved","Rejected","Scheduled","Published","Expired","Archived"}
			}
		}
	}
	reports
	{
		list announcement_Report
		{
			displayName = "All Announcements"
			show all rows from announcement    
			(
				title as "Title"
				message as "Message"
				category as "Category"
				valid_till as "Valid Till"
				posted_by as "Posted By"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (category == "Academic")
				fields = [category]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (category == "Event")
				fields = [category]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (category == "Placement")
				fields = [category]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban announcement_by_category
		{
			displayName = "Categories"
			show all rows from announcement    
			(
				title as "Title"
				message as "Message"
				category as "Category"
				valid_till as "Valid Till"
				posted_by as "Posted By"
			)
			options
			(
	 			display field = category
	 		)
		}
	}
	pages
	{
		page DashBoard
